# ============================================================
# Tencent Cloud CAM credentials (REQUIRED)
# Get from: https://console.cloud.tencent.com/cam/capi
# These are used to sign TokenHub Control Plane API requests.
# ============================================================
TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxx
TENCENTCLOUD_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TokenHub API region (international site default: ap-singapore)
TENCENTCLOUD_REGION=ap-singapore
